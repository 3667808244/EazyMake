# EazyMake — pacman 分发（Arch Linux / MSYS2）
#
# 自取 PKGBUILD + makepkg -si（需 base-devel）。AUR 提交延后（账户开通后补）。
# pkgver 指向 v1.4.4 正式 tag；sha256sums 为 v1.4.4 tag 源码 tarball 的真实 digest
# （https://codeload.github.com/3667808244/EazyMake/tar.gz/refs/tags/v1.4.4，2026-09-26
#  实测下载 1949019 字节；与 https://github.com/3667808244/EazyMake/archive/refs/tags/v1.4.4.tar.gz
#  重定向后的字节一致）
#
# 构建说明：build.sh 在 Linux 产出静态链接二进制（LDFLAGS="-static"），
# 故 depends 为空、makedepends 仅 gcc + python；ezmk-lua 为 dev.8 新增的
# CMake 导出钩子独立运行时，随包一并安装；_ezmk 为 zsh 补全；man/ 下 4 页
# （ezmk(1)、ezmk-lua(1)、ezmk.toml(5)、ezmk-workspace.toml(5)，1.4.3+）。

pkgname=eazymake
pkgver=1.4.4
pkgrel=1
pkgdesc="A simple C/C++ build tool (GCC/Clang/MSVC)"
arch=('x86_64')
url="https://github.com/3667808244/EazyMake"
license=('MIT')
makedepends=('gcc' 'python')
source=("$pkgname-$pkgver.tar.gz::https://github.com/3667808244/EazyMake/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('bd52470ce9825ae7bd2541125bd61a8c4a6baf604f603e55354481f9dbad5b3a')

build() {
  cd "EazyMake-$pkgver"
  EZMK_VERSION="$pkgver" bash build.sh
}

package() {
  cd "EazyMake-$pkgver"
  # Linux 产出 build/ezmk；Windows/MSYS2 产出 build/ezmk.exe（同源双变体）
  if [ -f build/ezmk.exe ]; then
    install -Dm755 build/ezmk.exe "$pkgdir/usr/bin/ezmk.exe"
    install -Dm755 build/ezmk-lua.exe "$pkgdir/usr/bin/ezmk-lua.exe"
  else
    install -Dm755 build/ezmk "$pkgdir/usr/bin/ezmk"
    install -Dm755 build/ezmk-lua "$pkgdir/usr/bin/ezmk-lua"
  fi
  install -Dm644 res/ezmk.zsh "$pkgdir/usr/share/zsh/site-functions/_ezmk"
  # 1.4.3: man pages (shared by the Linux and the MSYS2 branch above)
  install -Dm644 man/ezmk.1 "$pkgdir/usr/share/man/man1/ezmk.1"
  install -Dm644 man/ezmk-lua.1 "$pkgdir/usr/share/man/man1/ezmk-lua.1"
  install -Dm644 man/ezmk.toml.5 "$pkgdir/usr/share/man/man5/ezmk.toml.5"
  install -Dm644 man/ezmk-workspace.toml.5 "$pkgdir/usr/share/man/man5/ezmk-workspace.toml.5"
}
